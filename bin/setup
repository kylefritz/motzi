#!/usr/bin/env ruby
require 'fileutils'
require 'socket'
require 'timeout'

APP_ROOT = File.expand_path('..', __dir__)

def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

def pg_listening?(host, port)
  Timeout.timeout(1) { TCPSocket.new(host, port).close; true }
rescue StandardError
  false
end

FileUtils.chdir APP_ROOT do
  puts '== Installing dependencies =='
  system! 'gem install bundler --conservative'
  system('bundle check') || system!('bundle install')
  system! 'bun install'

  puts "\n== Checking services =="
  pg_host = ENV.fetch('PGHOST', '127.0.0.1')
  unless pg_listening?(pg_host, 5432)
    abort "\n== Postgres is not running on #{pg_host}:5432 (start postgres.app) =="
  end

  puts "\n== Preparing database =="
  # db:prepare is idempotent: it creates the database when it is missing and
  # otherwise runs pending migrations. Don't gate it on db:migrate:status --
  # that task raises NoDatabaseError on a fresh machine, and the error text
  # has no 'down' in it, so setup skipped db:prepare and failed a line later.
  system 'bin/pg-terminate' # free up any exclusive locks a migration would need
  system! 'bin/rails', 'db:prepare'
  system! 'bin/rails', 'solid_queue:bootstrap'

  puts "\n== Removing old logs and tempfiles =="
  system! 'bin/rails', 'log:clear', 'tmp:clear'

  puts "\n== Restarting application server =="
  system! 'bin/rails', 'restart'
end
