  },
  "version": "0.1.0",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14",
